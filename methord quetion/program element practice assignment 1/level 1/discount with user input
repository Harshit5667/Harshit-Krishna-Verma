import java.util.Scanner;

// Program to calculate discount and final price with user input for fee and discount.
public class DiscountCalculatorWithInput {

    public static void main(String[] args) {
        // Create a Scanner object to read user input.
        Scanner input = new Scanner(System.in);

        // Prompt the user for the student fee.
        System.out.print("Enter the student fee: ");
        double fee = input.nextDouble();

        // Prompt the user for the discount percentage.
        System.out.print("Enter the discount percentage: ");
        double discountPercent = input.nextDouble();

        // Calculate the discount amount.
        double discountAmount = fee * (discountPercent / 100);

        // Calculate the final discounted fee.
        double finalFee = fee - discountAmount;

        // Display the results.
        System.out.println("The discount amount is INR " + discountAmount + " and final discounted fee is INR " + finalFee);

        // Close the scanner.
        input.close();
    }
}
