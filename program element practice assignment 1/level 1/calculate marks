// A simple Java program to calculate the average percentage mark for a student.
import java.util.Scanner;
public class MarksCalculator {

    // The main method where the program execution begins.
    public static void main(String[] args) {

        // Define the marks obtained in each subject.
        int mathsMark = 94;
        int physicsMark = 95;
        int chemistryMark = 96;

        // Calculate the total marks obtained.
        int totalMarks = mathsMark + physicsMark + chemistryMark;

        // The number of subjects to calculate the average.
        int numberOfSubjects = 3;

        // Calculate the average mark. Using a double to ensure a precise result,
        // even if the division results in a decimal.
        double averageMark = (double) totalMarks / numberOfSubjects;

        // Print the final result to the console in the specified format.
        System.out.println("Sam's average mark in PCM is " + averageMark);
    }
}
