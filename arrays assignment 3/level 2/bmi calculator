import java.util.Scanner;

public class BMICalculator {

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        // Take input for the number of persons
        System.out.print("Enter the number of persons: ");
        int numberOfPersons = scanner.nextInt();

        // Create a 2D array to store height, weight, and BMI
        // The columns are: [0] = height, [1] = weight, [2] = BMI
        double[][] personData = new double[numberOfPersons][3];

        // Create an array to store the weight status
        String[] weightStatus = new String[numberOfPersons];

        // Loop to take input for weight and height
        for (int i = 0; i < numberOfPersons; i++) {
            System.out.println("\n--- Person " + (i + 1) + " ---");
            
            // Take and validate height input
            while (true) {
                System.out.print("Enter height (in meters): ");
                if (scanner.hasNextDouble()) {
                    personData[i][0] = scanner.nextDouble();
                    if (personData[i][0] <= 0) {
                        System.out.println("Invalid input. Height must be a positive value. Please enter again.");
                    } else {
                        break;
                    }
                } else {
                    System.out.println("Invalid input. Please enter a valid number.");
                    scanner.next(); // Consume the invalid input
                }
            }

            // Take and validate weight input
            while (true) {
                System.out.print("Enter weight (in kilograms): ");
                if (scanner.hasNextDouble()) {
                    personData[i][1] = scanner.nextDouble();
                    if (personData[i][1] <= 0) {
                        System.out.println("Invalid input. Weight must be a positive value. Please enter again.");
                    } else {
                        break;
                    }
                } else {
                    System.out.println("Invalid input. Please enter a valid number.");
                    scanner.next(); // Consume the invalid input
                }
            }
        }

        // Loop to calculate BMI and determine weight status
        for (int i = 0; i < numberOfPersons; i++) {
            // Calculate BMI: weight / (height * height)
            personData[i][2] = personData[i][1] / (personData[i][0] * personData[i][0]);

            // Determine weight status
            if (personData[i][2] < 18.5) {
                weightStatus[i] = "Underweight";
            } else if (personData[i][2] >= 18.5 && personData[i][2] < 24.9) {
                weightStatus[i] = "Normal weight";
            } else if (personData[i][2] >= 25 && personData[i][2] < 29.9) {
                weightStatus[i] = "Overweight";
            } else {
                weightStatus[i] = "Obesity";
            }
        }

        // Close the scanner
        scanner.close();

        // Display the results
        System.out.println("\n--- BMI Results ---");
        System.out.println("------------------------------------------------------------------");
        System.out.printf("%-10s %-10s %-10s %-15s\n", "Height (m)", "Weight (kg)", "BMI", "Status");
        System.out.println("------------------------------------------------------------------");

        for (int i = 0; i < numberOfPersons; i++) {
            System.out.printf("%-10.2f %-10.2f %-10.2f %-15s\n", 
                personData[i][0], 
                personData[i][1], 
                personData[i][2], 
                weightStatus[i]);
        }
    }
}