import java.util.Scanner;

// Program to calculate the mean height of a football team.
public class MeanHeight {
    public static void main(String[] args) {
        // Create a Scanner object to read user input.
        Scanner scanner = new Scanner(System.in);
        
        // Get the number of players from the user.
        System.out.print("Enter the number of players: ");
        int numPlayers = scanner.nextInt();
        
        // Declare an array to store the heights.
        double[] heights = new double[numPlayers];
        double sumOfHeights = 0;
        
        // Loop to get heights for each player.
        for (int i = 0; i < numPlayers; i++) {
            System.out.print("Enter the height of player " + (i + 1) + " (in feet): ");
            heights[i] = scanner.nextDouble();
            sumOfHeights += heights[i];
        }
        
        // Calculate the mean height.
        double meanHeight = sumOfHeights / numPlayers;
        
        // Display the result.
        System.out.println("The mean height of the football team is: " + meanHeight + " feet.");
        
        // Close the scanner.
        scanner.close();
    }
}
