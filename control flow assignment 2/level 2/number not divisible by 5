// Program to print numbers from 1 to 100 that are not divisible by 5.
import
public class NumbersNotDivisibleBy5 {

    public static void main(String[] args) {
        // Print a header for the output.
        System.out.println("Numbers not divisible by 5 between 1 to 100 is:");

        // Use a for loop to iterate from 1 to 100.
        for (int i = 1; i <= 100; i++) {
            // Check if the number is divisible by 5.
            if (i % 5 == 0) {
                // If it is, skip this iteration.
                continue;
            }
            
            // If the number is not divisible by 5, print it.
            System.out.println(i);
        }
    }
}
