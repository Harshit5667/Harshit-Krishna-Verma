

import java.util.Arrays;
import java.util.Scanner;

public class StringToCharArrayConverter {

    /**
     * Converts a string to a character array using a custom loop.
     *
     * @param text The input string.
     * @return A new character array containing the characters of the string.
     */
    public static char[] myToCharArray(String text) {
        char[] charArray = new char[text.length()];
        for (int i = 0; i < text.length(); i++) {
            charArray[i] = text.charAt(i);
        }
        return charArray;
    }

    /**
     * Compares two character arrays for equality.
     *
     * @param array1 The first character array.
     * @param array2 The second character array.
     * @return true if the arrays are identical, false otherwise.
     */
    public static boolean compareCharArrays(char[] array1, char[] array2) {
        // First, check if the lengths are different.
        if (array1.length != array2.length) {
            return false;
        }

        // Loop through each element and compare.
        for (int i = 0; i < array1.length; i++) {
            if (array1[i] != array2[i]) {
                return false;
            }
        }
        return true;
    }

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        // Take user input for a string.
        System.out.print("Enter a string: ");
        String text = scanner.nextLine();
        
        // Close the scanner.
        scanner.close();

        // Convert the string to a character array using the custom method.
        char[] customArray = myToCharArray(text);

        // Convert the string to a character array using the built-in method.
        char[] builtInArray = text.toCharArray();

        // Print both arrays for visual comparison.
        System.out.println("\nArray from custom method: " + Arrays.toString(customArray));
        System.out.println("Array from built-in toCharArray() method: " + Arrays.toString(builtInArray));

        // Compare the two arrays and display the result.
        boolean areEqual = compareCharArrays(customArray, builtInArray);

        if (areEqual) {
            System.out.println("\nBoth methods produced the same character array.");
        } else {
            System.out.println("\nThere was a mismatch between the methods.");
        }
    }
}
