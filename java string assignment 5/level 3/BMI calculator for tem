
import java.util.Scanner;

public class TeamBMICalculator {

    /**
     * Calculates the BMI status based on the BMI value.
     *
     * @param bmi The calculated BMI value.
     * @return A string representing the BMI status (e.g., "Underweight", "Normal").
     */
    public static String getBMIStatus(double bmi) {
        if (bmi < 18.5) {
            return "Underweight";
        } else if (bmi >= 18.5 && bmi <= 24.9) {
            return "Normal weight";
        } else if (bmi >= 25.0 && bmi <= 29.9) {
            return "Overweight";
        } else {
            return "Obese";
        }
    }

    /**
     * Calculates BMI and status for all persons and stores the results in a 2D String array.
     *
     * @param personData A 2D array where each row contains a person's weight (kg) and height (cm).
     * @return A 2D String array containing height (cm), weight (kg), calculated BMI, and BMI status.
     */
    public static String[][] calculateAndStoreBMI(double[][] personData) {
        // A 2D array to hold the final results: Height, Weight, BMI, and Status.
        String[][] results = new String[personData.length][4];

        for (int i = 0; i < personData.length; i++) {
            // Get height in cm and weight in kg from the input array.
            double weight = personData[i][0];
            double heightCm = personData[i][1];

            // Convert height from centimeters to meters for the BMI formula.
            double heightM = heightCm / 100.0;

            // Calculate BMI using the formula: BMI = weight / (height * height).
            double bmi = weight / (heightM * heightM);
            
            // Get the BMI status.
            String status = getBMIStatus(bmi);

            // Store the results in the results array.
            results[i][0] = String.format("%.2f", heightCm) + " cm";
            results[i][1] = String.format("%.2f", weight) + " kg";
            results[i][2] = String.format("%.2f", bmi);
            results[i][3] = status;
        }

        return results;
    }

    /**
     * Displays the 2D string array in a tabular format.
     *
     * @param data The 2D string array containing the data to display.
     */
    public static void displayResults(String[][] data) {
        System.out.println("\n---------------------------------------------------------");
        System.out.printf("%-10s | %-10s | %-10s | %-20s%n", "Height", "Weight", "BMI", "Status");
        System.out.println("---------------------------------------------------------");
        for (String[] row : data) {
            System.out.printf("%-10s | %-10s | %-10s | %-20s%n", row[0], row[1], row[2], row[3]);
        }
        System.out.println("---------------------------------------------------------");
    }

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        final int NUMBER_OF_PERSONS = 10;
        
        // A 2D array to store the weight and height of each person.
        // Column 0 for weight, Column 1 for height.
        double[][] personData = new double[NUMBER_OF_PERSONS][2];

        System.out.println("Please enter the weight and height for 10 team members.");
        
        // Loop to take user input for all 10 persons.
        for (int i = 0; i < NUMBER_OF_PERSONS; i++) {
            System.out.println("\nPerson " + (i + 1) + ":");
            double weight = 0;
            double height = 0;

            // Input validation for weight.
            while (true) {
                System.out.print("Enter weight in kg: ");
                weight = scanner.nextDouble();
                if (weight > 0) {
                    break;
                }
                System.out.println("Invalid input. Weight must be a positive number.");
            }

            // Input validation for height.
            while (true) {
                System.out.print("Enter height in cm: ");
                height = scanner.nextDouble();
                if (height > 0) {
                    break;
                }
                System.out.println("Invalid input. Height must be a positive number.");
            }
            
            // Store the validated data.
            personData[i][0] = weight;
            personData[i][1] = height;
        }

        scanner.close();

        // Calculate the BMI and status for all persons.
        String[][] results = calculateAndStoreBMI(personData);

        // Display the final results in a table.
        displayResults(results);
    }
}
