// This program determines the voting eligibility of a specified number of students.
// It generates random ages, validates them, and displays a report in a tabular format.

import java.util.Scanner;
import java.util.Random;

public class VotingEligibilityChecker {

    /**
     * Generates a 1D array of random 2-digit ages for a specified number of students.
     * Ages are between 10 and 99, inclusive.
     *
     * @param numberOfStudents The number of student ages to generate.
     * @return An integer array containing the random ages.
     */
    public static int[] getRandomAges(int numberOfStudents) {
        Random random = new Random();
        int[] ages = new int[numberOfStudents];
        // Generate random ages from 10 to 99 (inclusive of both).
        int minAge = 10;
        int maxAge = 99;
        for (int i = 0; i < numberOfStudents; i++) {
            ages[i] = random.nextInt(maxAge - minAge + 1) + minAge;
        }
        return ages;
    }

    /**
     * Checks the voting eligibility for each age in an array.
     *
     * @param ages The integer array of student ages.
     * @return A 2D String array where each row contains the age and a string
     * ("true" or "false") indicating voting eligibility.
     */
    public static String[][] checkVotingEligibility(int[] ages) {
        // The 2D array will hold age and eligibility status.
        String[][] eligibilityData = new String[ages.length][2];

        for (int i = 0; i < ages.length; i++) {
            int currentAge = ages[i];
            eligibilityData[i][0] = String.valueOf(currentAge);

            // Validate age for negative numbers and check for eligibility.
            if (currentAge >= 18) {
                eligibilityData[i][1] = "true";
            } else {
                eligibilityData[i][1] = "false";
            }
        }
        return eligibilityData;
    }

    /**
     * Displays the voting eligibility results in a formatted table.
     *
     * @param eligibilityData A 2D String array containing age and eligibility status.
     */
    public static void displayResults(String[][] eligibilityData) {
        System.out.println("\n--- Voting Eligibility Report ---");
        System.out.printf("%-10s | %-15s%n", "Age", "Can Vote?");
        System.out.println("---------------------------------");
        for (int i = 0; i < eligibilityData.length; i++) {
            System.out.printf("%-10s | %-15s%n", eligibilityData[i][0], eligibilityData[i][1]);
        }
        System.out.println("---------------------------------");
    }

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        // Take user input for the number of students.
        System.out.print("Enter the number of students to check: ");
        int numberOfStudents = scanner.nextInt();

        // Get random ages for the students.
        int[] ages = getRandomAges(numberOfStudents);

        // Determine the voting eligibility for each student.
        String[][] eligibilityData = checkVotingEligibility(ages);

        // Display the results.
        displayResults(eligibilityData);

        scanner.close();
    }
}
